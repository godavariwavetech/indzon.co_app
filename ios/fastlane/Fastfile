require 'base64'

default_platform(:ios)

platform :ios do
  desc 'Build and upload the iOS app to TestFlight'
  lane :beta do
    bundle_id = ENV.fetch('IOS_BUNDLE_ID')
    team_id = ENV.fetch('IOS_TEAM_ID')
    profile_name = ENV.fetch('IOS_PROVISIONING_PROFILE_NAME')

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch('APP_STORE_CONNECT_KEY_ID'),
      issuer_id: ENV.fetch('APP_STORE_CONNECT_ISSUER_ID'),
      key_content: Base64.decode64(ENV.fetch('APP_STORE_CONNECT_KEY_BASE64')),
      is_key_content_base64: false
    )

    increment_build_number(
      build_number: ENV.fetch('GITHUB_RUN_NUMBER', '1'),
      xcodeproj: 'localdaddy.xcodeproj'
    )

    build_app(
      workspace: 'localdaddy.xcworkspace',
      scheme: 'localdaddy',
      configuration: 'Release',
      clean: true,
      export_method: 'app-store',
      output_directory: '../build/ios',
      output_name: 'Indzon.ipa',
      xcargs: "DEVELOPMENT_TEAM=#{team_id} PRODUCT_BUNDLE_IDENTIFIER=#{bundle_id}",
      export_options: {
        signingStyle: 'manual',
        provisioningProfiles: { bundle_id => profile_name }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: '../build/ios/Indzon.ipa',
      skip_waiting_for_build_processing: true
    )
  end
end
